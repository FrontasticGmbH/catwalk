{
    "name": "frontastic/catwalk",
    "version": "1.71.0",
    "license": "None",
    "type": "library",
    "repositories": [
        {
            "type": "path",
            "url": "../libraries/*"
        }
    ],
    "config": {
        "discard-changes": true
    },
    "conflict": {
        "frontastic/payment-adyen": "<1.2.0",
        "symfony/clock": ">=8.0",
        "symfony/mime": ">=8.0",
        "symfony/options-resolver": ">=8.0",
        "symfony/password-hasher": ">=8.0",
        "symfony/property-info": ">=8.0",
        "symfony/security-csrf": ">=8.0",
        "symfony/string": ">=8.0",
        "symfony/twig-bridge": ">=8.0",
        "symfony/type-info": ">=8.0",
        "symfony/var-dumper": ">=8.0"
    },
    "require":      {
        "php": ">=8.1",
        "ext-json": "*",

        "symfony/framework-bundle": "^6.4||^7.4",
        "symfony/twig-bundle": "^6.4||^7.4",
        "symfony/security-bundle": "^6.4||^7.4",
        "symfony/security-core": "^6.4||^7.4",
        "symfony/security-http": "^6.4||^7.4",
        "symfony/http-foundation": "^6.4||^7.4",
        "symfony/http-kernel": "^6.4||^7.4",
        "symfony/cache": "^6.4||^7.4",
        "symfony/console": "^6.4||^7.4",
        "symfony/form": "^6.4||^7.4",
        "symfony/validator": "^6.4||^7.4",
        "symfony/serializer": "^6.4||^7.4",
        "symfony/asset": "^6.4||^7.4",
        "symfony/process": "^6.4||^7.4",
        "symfony/property-access": "^6.4||^7.4",
        "symfony/yaml": "^6.4||^7.4",
        "symfony/error-handler": "^6.4||^7.4",
        "symfony/dotenv": "^6.4||^7.4",
        "symfony/psr-http-message-bridge": "^2.3||^7.3",
        "symfony/polyfill-apcu": "^1.0",
        "symfony/monolog-bridge": "^6.4",
        "symfony/monolog-bundle": "^3.11",
        "symfony/finder": "^6.4||^7.4",
        "symfony/filesystem": "^6.4||^7.4",
        "doctrine/doctrine-bundle": "^2.18",

        "frontastic/common": "^2.51.0",

        "doctrine/orm": "^2.20",
        "doctrine/dbal": "^3.10",
        "guzzlehttp/guzzle": "^7",

        "frontastic/data-object": "@stable",
        "beberlei/doctrineextensions": "@stable",

        "predis/predis": "@stable",
        "michelf/php-markdown": "@stable",
        "aptoma/twig-markdown": "@stable",
        "dragonmantank/cron-expression": "^3.3",
        "frontastic/rulerz-bundle": "^0.16||^0.17",
        "zetacomponents/graph": "^1.5",
        "ramsey/uuid": "^4",
        "jaybizzle/crawler-detect": "^1.2",
        "firebase/php-jwt": "^v6.4.0||^7.0",
        "composer-runtime-api": "^2.2",
        "psr/simple-cache": "^1.0||^2.0||^3.0",
        "monolog/monolog": "^2.0"
    },
    "require-dev":  {
        "phpunit/phpunit": "^10",
        "phpmd/phpmd": "@stable",
        "pdepend/pdepend": "@stable",
        "squizlabs/php_codesniffer": "@stable",
        "symfony/phpunit-bridge": "^6.4||^7.4",
        "phake/phake": "^4.0",
        "phpstan/phpstan": "^2.0",
        "mikey179/vfsstream": "^1"
    },
    "autoload": {
        "psr-4": {
            "Frontastic\\Catwalk\\": "src/php",
            "Kameleoon\\": "libraries/kameleoon/kameleoon/client/src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Frontastic\\Catwalk\\": "test/php/"
        }
    }
}
